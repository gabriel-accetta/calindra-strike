# Copy to .env on the server (next to compose.yaml)
ALLOWED_ORIGINS=http://localhost:5173
MATCH_SECONDS=300
PODIUM_SECONDS=15
MAX_PLAYERS=24
WARMUP_MIN_PLAYERS=2
# Modes in the rotation and the end-of-match vote (default: tdm, ffa; defuse disabled)
GAME_MODES=tdm,ffa
# Maps in the rotation and the vote, any of: forja, escritorio (empty = all)
GAME_MAPS=
# Defuse: first team to this many round wins takes the match
DEFUSE_ROUNDS_TO_WIN=8
# Team kills that end a TDM match early (0 = timer only)
TDM_SCORE_LIMIT=50
# Bots top the match up to this many players while at least one person is online (0 = no bots, the default)
BOT_FILL=0
# Bot skill 0-100
BOT_SKILL=45
# Optional: require an office code to join (leave empty for open lobby)
JOIN_CODE=
