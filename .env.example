# Copy to .env on the server (next to compose.yaml)
ALLOWED_ORIGINS=http://localhost:5173
MATCH_SECONDS=300
PODIUM_SECONDS=15
MAX_PLAYERS=24
WARMUP_MIN_PLAYERS=2
# mixed = rotate Team Deathmatch and free-for-all; or force ffa / tdm / defuse
# defuse automatically selects Dust2, with fixed ground spawns
GAME_MODE=mixed
# Defuse match: first team to this many round wins
DEFUSE_ROUNDS_TO_WIN=8
# Optional: pin one map (dust2, forja, escritorio); empty rotates all maps
GAME_MAP=
# Team kills that end a TDM match early (0 = timer only)
TDM_SCORE_LIMIT=50
# Optional: require an office code to join (leave empty for open lobby)
JOIN_CODE=
